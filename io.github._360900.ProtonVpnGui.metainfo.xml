<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github._360900.ProtonVpnGui</id>
  <name>Proton VPN GUI</name>
  <summary>Community Qt interface for the Proton VPN CLI</summary>
  <description>
    <p>
      A lightweight Qt-based graphical interface for the Proton VPN command-line
      tool. Supports connecting to servers by country or city, account management,
      favorites, connection history, and VPN settings.
    </p>
    <p>
      When running as a Flatpak, the app communicates with the Proton VPN CLI
      installed on the host system via flatpak-spawn. The CLI must be installed
      separately.
    </p>
  </description>

