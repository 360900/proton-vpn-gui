<RCC version="1.0">
    <qresource prefix="/assets">
        <file alias="proton-vpn-logo.svg">assets/proton-vpn-logo.svg</file>
        <file alias="proton-vpn-sign.svg">assets/proton-vpn-sign.svg</file>
        <file alias="state-connected.svg">assets/state-connected.svg</file>
        <file alias="state-disconnected.svg">assets/state-disconnected.svg</file>
        <file alias="state-error.svg">assets/state-error.svg</file>
        <file alias="maintenance-icon.svg">assets/maintenance-icon.svg</file>
        <file alias="no-app-icon.svg">assets/no-app-icon.svg</file>
        <file alias="security-key.svg">assets/security-key.svg</file>
        <file alias="eye-hide.svg">assets/eye/hide.svg</file>
        <file alias="eye-show.svg">assets/eye/show.svg</file>
        <file alias="server-p2p.svg">assets/servers/p2p.svg</file>
        <file alias="server-secure-core.svg">assets/servers/secure-core.svg</file>
        <file alias="server-smart-routing.svg">assets/servers/smart-routing.svg</file>
        <file alias="server-streaming.svg">assets/servers/streaming.svg</file>
