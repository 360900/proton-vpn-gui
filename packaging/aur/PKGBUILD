# Maintainer: 360900
pkgname=proton-vpn-gui
pkgver=2.0.0
pkgrel=1
pkgdesc='Qt 6 graphical interface for the Proton VPN Linux CLI'
arch=('x86_64')
url='https://github.com/360900/proton-vpn-gui'
license=('GPL-3.0-only')
depends=('proton-vpn-cli' 'qt6-base' 'qt6-declarative' 'qt6-svg')
makedepends=('cmake' 'ninja' 'qt6-tools')
optdepends=('libnatpmp: port forwarding support')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/$pkgname/src" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
